ACTOR DualMAC : Weapon
{
   Weapon.SelectionOrder 700
   Weapon.SlotNumber 4
   weapon.ammogive1 0
   weapon.ammogive2 64
   weapon.ammotype1 "DualMACLoaded"
   weapon.ammotype2 "Clip"
   weapon.ammouse1 1
   weapon.ammouse2 1
   Inventory.PickupMessage "You got the Dual MAC-10s! Bring the pain!"
   Obituary "%o met someone who only plays for sport."
   Tag "Dual MAC-10s"
   Scale 0.6
   +AMMO_CHECKBOTH
   +NOAUTOFIRE
   +WEAPON.NOALERT
   States
   {
   Ready:
     MACI A 1 A_WeaponReady(WRF_ALLOWRELOAD)
     Loop
   Deselect:
     MACI A 1 A_Lower
     MACI AA 0 A_Lower
     Loop
   Select:
     MACI A 1 A_Raise
     MACI AA 0 A_Raise
     Loop
   Fire:
     TNT1 A 0 A_JumpIf(CountInv("DualMACLoaded") == 0,"Reload")
	 TNT1 A 0 A_AlertMonsters
 	 TNT1 A 0 A_PlaySound("MACFIRE", CHAN_WEAPON)
	 TNT1 A 0 A_FireBullets(5.5, 5.5, -1, 5)
	 TNT1 A 0 A_JumpIfInventory("MACFireSwap",1,"Fire2")
	 Goto Fire1
   Fire1:
     MACL A 1 BRIGHT A_WeaponReady(WRF_NOFIRE|WRF_NOSECONDARY|WRF_NOSWITCH)
	 TNT1 A 0 A_Quake(2, 2, 0, 48576, "None")
	 TNT1 A 0 A_GiveInventory("MACFireSwap",1)
     MACL B 1 BRIGHT A_WeaponReady(WRF_NOFIRE|WRF_NOSECONDARY|WRF_NOSWITCH)
	 MACI A 0 A_ReFire("Fire")
	 Goto Ready
   Fire2:
     MACR A 1 BRIGHT A_WeaponReady(WRF_NOFIRE|WRF_NOSECONDARY|WRF_NOSWITCH)
	 TNT1 A 0 A_Quake(2, 2, 0, 48576, "None")
	 TNT1 A 0 A_TakeInventory("MACFireSwap",99)
     MACR B 1 BRIGHT A_WeaponReady(WRF_NOFIRE|WRF_NOSECONDARY|WRF_NOSWITCH)
	 MACI A 0 A_ReFire("Fire")
	 Goto Ready
Reload:
     TNT1 A 0 A_JumpIfInventory("DualMACLoaded", 64, 2)
     TNT1 A 0 A_JumpIfInventory("Clip", 1, "ReloadWork")
     MACI A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSECONDARY)
     Goto Ready
ReloadWork:
	 D9RA A 0 A_TakeInventory("MACFireSwap",1)
     DACR A 1
     DACR BC 1
     TNT1 A 0 A_PlaySoundEX("MACREL1",CHAN_7)
	 TNT1 A 1
	 TNT1 A 0 A_PlaySoundEX("MACREL1",CHAN_6)
	 TNT1 A 5
	 RACL ABCD 1
	 RACL E 5
     TNT1 A 0 A_PlaySoundEX("MACREL2",CHAN_6)
     RACL FGHI 1
	 RACL JK 2
     RACL LMAN 1
	 TNT1 A 5
	 RACR ABCD 1
	 RACR E 5
	 TNT1 A 0 A_PlaySoundEX("MACREL2",CHAN_6)
     RACR FGHI 1
	 RACR JK 2
     RACR LMAN 1
     TNT1 A 2
ReloadLoop:
     TNT1 A 0 A_TakeInventory("Clip", 1)
	 TNT1 A 0 A_GiveInventory("DualMACLoaded",1)
     TNT1 A 0 A_JumpIfInventory("DualMACLoaded", 64, "ReloadFinish")
     TNT1 A 0 A_JumpIfInventory("Clip", 1, "ReloadLoop")
     Goto ReloadFinish
ReloadFinish:
     DACR G 1
	 TNT1 A 0 A_PlaySoundEX("MACREL3",CHAN_7)
	 DACR FE 1
     DACR AHD 1
     TNT1 A 0 A_Refire("Fire")
     Goto Ready
   Spawn:
     MACG A -1
     Stop
   }
}

ACTOR DualMACLoaded : Ammo
{
   +IGNORESKILL
   Inventory.Amount 0
   Inventory.MaxAmount 64
   Ammo.BackpackAmount 0
   Ammo.BackpackMaxAmount 64
}

ACTOR MACFireSwap : Inventory { Inventory.MaxAmount 1 }