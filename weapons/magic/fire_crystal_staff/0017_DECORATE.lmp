////////////////////////////////////////////////////////////////// POWERED //////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

ACTOR FireCrystalPowered : FireCrystal
{
  -BLOODSPLATTER
  Weapon.SelectionOrder 2000
  Weapon.SisterWeapon "FireCrystal"
  Inventory.PickupMessage "Fire Crystal"
  Weapon.YAdjust 0
  +WEAPON.POWERED_UP
  Obituary "%o was incinerated by %k's Fire Crystal"
  
  States
  {
  Fire:
    FWND B 0 BRIGHT
    FWND B 4 BRIGHT A_PlaySound("FireCrystal2")
    FWND B 0 A_FireCustomMissile ("FireWaveCreatorPowered", 0, 0, 0, 9)
    FWND C 4 BRIGHT
    FWND D 4 BRIGHT
    FWND E 4 BRIGHT
    TNT1 A 5 
    FWND FA 4
    FWND A 0 A_ReFire
    Goto Ready
  }
}

actor FireWaveCreatorPowered : FastProjectile
{
  height 2
  radius 16
  damage 8
  speed 160
  renderstyle None
  alpha 1
  PROJECTILE
  -ACTIVATEIMPACT 
  -ACTIVATEPCROSS
  +DONTSPLASH
  +NOBLOOD 
  +NOBLOODDECALS
  
  states
  {
  Spawn:
    TNT1 A 0 
  Death:
    TNT1 A 0 
    TNT1 A 0 A_Stop
    TNT1 A 1 A_CustomMissile("FireWavePowered", 0, 56)
    TNT1 A 0 A_CustomMissile("FireWavePowered", 0, 48)
    TNT1 A 1 A_CustomMissile("FireWavePowered", 0, 40)
    TNT1 A 0 A_CustomMissile("FireWavePowered", 0, 32)
    TNT1 A 1 A_CustomMissile("FireWavePowered", 0, 24)
    TNT1 A 0 A_CustomMissile("FireWavePowered", 0, 16)
    TNT1 A 1 A_CustomMissile("FireWavePowered", 0, 8)
    TNT1 A 0 A_CustomMissile("FireWavePowered", 0, 0)
    TNT1 A 1 A_CustomMissile("FireWavePowered", 0, -8)
    TNT1 A 0 A_CustomMissile("FireWavePowered", 0, -16)
    TNT1 A 1 A_CustomMissile("FireWavePowered", 0, -24)
    TNT1 A 0 A_CustomMissile("FireWavePowered", 0, -32)
    TNT1 A 1 A_CustomMissile("FireWavePowered", 0, -40)
    TNT1 A 0 A_CustomMissile("FireWavePowered", 0, -48)
    TNT1 A 1 A_CustomMissile("FireWavePowered", 0, -56)
    stop
  }
}

