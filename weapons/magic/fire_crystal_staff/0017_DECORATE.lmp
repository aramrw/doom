ACTOR FireCrystal : HereticWeapon
{
  -BLOODSPLATTER
  Weapon.SelectionOrder 2000
  Weapon.SisterWeapon "FireCrystalPowered"
  Inventory.PickupMessage "Fire Crystal"
  Weapon.YAdjust 0
  Obituary "%o was burned to death by %k's Fire Crystal"
  
  States
  {
  Spawn:
    FWND Z -1
    Stop
  Ready:
    FWND A 1 A_WeaponReady
    Loop
  Deselect:
    FWND A 1 A_Lower
    Loop
  Select:
    FWND A 1 A_Raise
    Loop
  Fire:
    FWND B 0 BRIGHT
    FWND B 4 BRIGHT A_PlaySound("FireCrystal2")
    FWND B 0 A_FireCustomMissile ("FireWaveCreator", 0, 0, 0, 9)
    FWND C 4 BRIGHT
    FWND D 4 BRIGHT
    FWND E 4 BRIGHT
    TNT1 A 5 
    FWND FA 4
    FWND A 0 A_ReFire
    Goto Ready
  }
}

actor FireWaveCreator : FastProjectile
{
  height 2
  radius 16
  damage 5
  speed 96
  renderstyle None
  alpha 1
  PROJECTILE
  -ACTIVATEIMPACT 
  -ACTIVATEPCROSS
  +DONTSPLASH
  +NOBLOOD 
  +NOBLOODDECALS
  
  states
  {
  Spawn:
    TNT1 A 0 
  Death:
    TNT1 A 0 
    TNT1 A 0 A_Stop
    TNT1 A 1 A_CustomMissile("FireWave", 0, 32)
    TNT1 A 1 A_CustomMissile("FireWave", 0, 24)
    TNT1 A 1 A_CustomMissile("FireWave", 0, 16)
    TNT1 A 1 A_CustomMissile("FireWave", 0, 8)
    TNT1 A 1 A_CustomMissile("FireWave", 0, 0)
    TNT1 A 1 A_CustomMissile("FireWave", 0, -8)
    TNT1 A 1 A_CustomMissile("FireWave", 0, -16)
    TNT1 A 1 A_CustomMissile("FireWave", 0, -24)
    TNT1 A 1 A_CustomMissile("FireWave", 0, -32)
    stop
  }
}

actor FireWave : FastProjectile
{
  height 2
  radius 16
  damage (1)
  speed 0
  renderstyle Add
  alpha 1
  seesound "misc/shot"
  deathsound "misc/shotx"
  damagetype "Fire"
  PROJECTILE
  -ACTIVATEIMPACT 
  -ACTIVATEPCROSS
  +DONTSPLASH
  +NOBLOOD 
  +NOBLOODDECALS
  yscale 0.25
  xscale 0.38
  
  states
  {
  Spawn:
    TNT1 A 1 bright
  Death:
    TNT1 A 0 bright A_Stop
    TNT1 A 0 bright
    FATT AAAABBBBCCCC 1 bright A_FadeOut(0.07)
    stop
  }
}

