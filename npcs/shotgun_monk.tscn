[sub_resource type="SphereShape3D" id="SphereShape3D_au4qf"]
radius = 2.019645

[sub_resource type="DialogueLine" id="DialogueLine_udfx5"]
text = "俺はヴァチカン特務第１３課イスカリオテ機関の藤沢マーレでございます。これからよろしく"
audio = ExtResource("49_s8yxr")

[sub_resource type="DialogueLine" id="DialogueLine_my845"]
text = "忘れてたか...ヤベー。"
audio = ExtResource("48_rpv6j")
next_line = SubResource("DialogueLine_udfx5")

[sub_resource type="DialogueChoice" id="DialogueChoice_rpv6j"]
label = "誰だお前？"
next_node = SubResource("DialogueLine_my845")

[sub_resource type="DialogueLine" id="DialogueLine_s8yxr"]
text = "どこにどこでもある。。。この凄まじい感じ。。。強い！"
audio = ExtResource("49_ckj4m")

[sub_resource type="DialogueChoice" id="DialogueChoice_udfx5"]
label = "なんだこの圧力！"
next_node = SubResource("DialogueLine_s8yxr")

[sub_resource type="DialogueLine" id="DialogueLine_31sx5"]
text = "そりゃどうでもいい、とにかく銃を見つけなきゃこまる。"
audio = ExtResource("52_4reaw")

[sub_resource type="DialogueLine" id="DialogueLine_kv7hp"]
text = "落ち着け。お前も、この腐れた洞窟の事もなにも知らぬ。"
audio = ExtResource("51_nxkge")
next_line = SubResource("DialogueLine_31sx5")

[sub_resource type="DialogueChoice" id="DialogueChoice_rqp60"]
label = "俺は誰、とどこかここ！"
next_node = SubResource("DialogueLine_kv7hp")

[sub_resource type="DialogueLine" id="DialogueLine_au4qf"]
text = "まだ生きてる事こそ称えます"
line_type = 1
choices = Array[DialogueChoice]([SubResource("DialogueChoice_rpv6j"), SubResource("DialogueChoice_udfx5"), SubResource("DialogueChoice_rqp60")])

