[sub_resource type="RsDialogueLine" id="RsDialogueLine_02r0r"]
text = "無礼な者、おりゃダーゾッぐだ、アーラン王国の大鬼才だ。馬鹿げた事を聞くな。"
audio = ExtResource("9_lugeh")

[sub_resource type="RsDialogueChoice" id="RsDialogueChoice_lugeh"]
label = "誰だ？"
next_node = SubResource("RsDialogueLine_02r0r")

[sub_resource type="RsDialogueLine" id="RsDialogueLine_lugeh"]
text = "帝国の事か...。強い国だ。アーラン王様も優しい、文句がない程の。"
audio = ExtResource("10_fx87p")

[sub_resource type="RsDialogueChoice" id="RsDialogueChoice_fx87p"]
label = "オットマン帝国について"
next_node = SubResource("RsDialogueLine_lugeh")

[sub_resource type="RsDialogueLine" id="RsDialogueLine_b24xl"]
text = "王と歩んだ栄光の日...。このダルゾグ、地の底で何を綴ればいい"
audio = ExtResource("11_q8n3i")

[sub_resource type="RsDialogueChoice" id="RsDialogueChoice_ivaj6"]
label = "どうやって来た？"
next_node = SubResource("RsDialogueLine_b24xl")

[sub_resource type="RsDialogueLine" id="RsDialogueLine_au4qf"]
text = "聞きたい事はなんだ？"
