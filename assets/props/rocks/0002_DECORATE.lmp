ACTOR RockGrey 16000
{
	//$Title Grey Rock
	//$Category Obstacles/Rocks
	//$IsDecoration
	//$NotAngled
	Scale 0.75
	Radius 12
	Height 8
	+SOLID

	States
	{
	Spawn:
		DROK A 0 NoDelay A_ChangeFlag("SPRITEFLIP", random(0,1))
		DROK A 0 A_Jump (256, "Rock1", "Rock2", "Rock3")
	Rock1:
		DROK A -1
		stop
	Rock2:
		DROK B -1
		stop
	Rock3:
		DROK C -1
		stop
	}
}

