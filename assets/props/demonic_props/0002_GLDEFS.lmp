    frame CAND {light CANDLE2}
}

pointlight FIRESTAT
{
    color 1.0 1.0 0.3
    size 90
    offset 0 50 0
	attenuate 1
}

object FireStatue
{
    frame FSTAA {light FIRESTAT}
	frame FSTAB {light FIRESTAT}
	frame FSTAC {light FIRESTAT}
}

