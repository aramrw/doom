pointlight CANDLE1
{
    color 1.0 1.0 0.3
    size 24
    offset 0 22 0
	attenuate 1
}

object BlackCandle1
{
    frame CAND {light CANDLE1}
}

pointlight CANDLE2
{
    color 1.0 1.0 0.3
    size 24
    offset 0 18 0
	attenuate 1
}

object BlackCandle2
